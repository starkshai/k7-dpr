# ============================================================================
# diag_boot.tcl - source in Vivado Hardware Manager Tcl Console
#
# Purpose: read the LIVE state of the design after power-on, without pressing
# any key. Answers three questions at once:
#   1. What does the PRC status register say right now (status_code / rm_id)?
#   2. Are rm_decouple / rm_reset stuck asserted (which would freeze the RM)?
#   3. Is the ICAP being written at all, and what is icap_status during writes?
#
# Both ILA captures are IMMEDIATE (no trigger conditions), so they show the
# current state instead of waiting for an event that may never happen.
#
# Usage:
#   1. Board powered from SPI with the 17:03 pr_prom.mcs. Do NOT download a
#      bitstream, do NOT press key1.
#   2. In the Tcl Console:  cd <project root>
#   3. source ilaset/diag_boot.tcl
#   4. Output files: ilaset/diag_boot_vs.csv and ilaset/diag_boot_icap.csv
# ============================================================================

if {[llength [get_hw_targets]] == 0} { open_hw_manager }
if {[llength [get_hw_servers]] == 0} { connect_hw_server }
if {[llength [get_hw_targets]] == 0} { open_hw_target }

set dev [lindex [get_hw_devices -filter {NAME =~ "*xc7k325t*"}] 0]
if {$dev eq ""} { set dev [lindex [get_hw_devices] 0] }
current_hw_device $dev

# Snapshot of the probe file from the 17:03 fix#6 build - the one that is
# actually on the board. Bitstreams/config_shift_right.ltx is being
# regenerated by the fix#7 rebuild, so do not point at it.
set ltx "ilaset/ltx_fix6_1703.ltx"
if {![file exists $ltx]} { set ltx "Bitstreams/config_shift_right.ltx" }
if {[file exists $ltx]} {
    set_property PROBES_FILE  $ltx $dev
    set_property FULL_PROBES_FILE $ltx $dev
}
refresh_hw_device $dev

puts "=============================================================="
puts " ILA cores found:"
foreach i [get_hw_ilas] {
    puts "   $i : [get_hw_probes -of_objects $i]"
}
puts "=============================================================="

# ---------------------------------------------------------------------------
# Part 1: PRC status over JTAG-to-AXI
# ---------------------------------------------------------------------------
source Sources/scripts/axi_lite_procs.tcl
if {[llength [get_hw_axis]] > 0} {
    prc_jtag_setup
    puts "---- PRC live status (power-on, no key press) ----"
    prc_decode_status vs_shift
    puts "---- hw trigger registers ----"
    foreach t {vs_shift_trigger0 vs_shift_trigger1 vs_shift_trigger2 vs_shift_trigger3} {
        puts [format "  %-20s = 0x%08x" $t [prc_read_register $t]]
    }
} else {
    puts "WARN: no hw_axi found - skipping PRC register reads"
}

# ---------------------------------------------------------------------------
# Helper: immediate capture.
# Clearing EVERY trigger condition leaves the core with nothing to arm on and
# it returns an empty capture. Instead clear all, then set one probe to the
# "any" edge code N, which is always true and fires straight away.
# ---------------------------------------------------------------------------
proc capture_now {ila outfile} {
    set ps [get_hw_probes -of_objects $ila]
    set_property TRIGGER_COMPARE_VALUE {} $ps
    set_property TRIGGER_COMPARE_VALUE {N} [lindex $ps 0]
    run_hw_ila $ila
    wait_on_hw_ila $ila
    set d [current_hw_ila_data]
    puts "  capture object: $d"
    write_hw_ila_data -force $outfile $d
    puts "Saved $outfile"
    return $d
}

# ---------------------------------------------------------------------------
# Part 2: VS / PRC signals right now
# ---------------------------------------------------------------------------
set ila_vs ""
set ila_icap ""
foreach i [get_hw_ilas] {
    set pn [get_hw_probes -of_objects $i]
    if {[lsearch -glob $pn "*rm_decouple*"] >= 0} { set ila_vs   $i }
    if {[lsearch -glob $pn "*icap_csib*"]   >= 0} { set ila_icap $i }
}

if {$ila_vs ne ""} {
    puts "---- VS capture ($ila_vs) ----"
    set d [capture_now $ila_vs ilaset/diag_boot_vs.csv]
    set rows [get_hw_ila_data $d]
    set last [lindex $rows end]
    puts "  last sample:"
    foreach {k v} $last { puts [format "    %-40s = %s" $k $v] }
    # Count how many samples have decouple or rm_reset asserted.
    set ndc 0; set nrs 0; set n 0
    set first_status ""; set last_status ""
    foreach r $rows {
        incr n
        set dc ""; set rs ""; set st ""
        foreach {k v} $r {
            if {[string match {*rm_decouple*} $k]} { set dc $v }
            if {[string match {*rm_reset*}    $k]} { set rs $v }
            if {[string match {*axis_status*} $k]} { set st $v }
        }
        if {$dc ne "" && [string index $dc end] eq "1"} { incr ndc }
        if {$rs ne "" && [string index $rs end] eq "1"} { incr nrs }
        if {$st ne ""} { if {$first_status eq ""} { set first_status $st }; set last_status $st }
    }
    puts [format "  samples=%d  decouple_high=%d  rm_reset_high=%d" $n $ndc $nrs]
    puts "  axis_status first=$first_status last=$last_status"
} else {
    puts "WARN: VS ILA not found"
}

# ---------------------------------------------------------------------------
# Part 3: ICAP right now
# ---------------------------------------------------------------------------
if {$ila_icap ne ""} {
    puts "---- ICAP capture ($ila_icap) ----"
    set d [capture_now $ila_icap ilaset/diag_boot_icap.csv]
    set rows [get_hw_ila_data $d]
    set n 0; set nwrite 0
    set status_seen {}
    set wstatus_seen {}
    set first_words {}
    foreach r $rows {
        incr n
        set cv ""; set iv ""; set sv ""
        foreach {k v} $r {
            if {[string match {*icap_csib*}   $k]} { set cv $v }
            if {[string match {*icap_i\[*}    $k]} { set iv $v }
            if {[string match {*icap_status*} $k]} { set sv $v }
        }
        lappend status_seen $sv
        if {[string index $cv end] eq "0"} {
            incr nwrite
            lappend wstatus_seen $sv
            if {[llength $first_words] < 24} {
                lappend first_words [format "%s/%s" $iv $sv]
            }
        }
    }
    puts [format "  samples=%d  icap writes (csib=0)=%d" $n $nwrite]
    puts "  distinct icap_status over ALL samples : [lsort -unique $status_seen]"
    puts "  distinct icap_status during WRITES    : [lsort -unique $wstatus_seen]"
    puts "  first 24 ICAP words (icap_i/status):"
    foreach w $first_words { puts "    $w" }
} else {
    puts "WARN: ICAP ILA not found"
}

puts "=============================================================="
puts " How to read the result:"
puts "   axis_status / PRC status 0x107 = FULL rm_id1 (POR shift_right, idle)"
puts "                        0x004 = LOAD  (stuck mid reconfiguration)"
puts "                        0x007 = FULL rm_id0 (shift_left loaded)"
puts "   decouple_high > 0 with status LOAD  => VS stuck, RM held => LED frozen"
puts "   icap writes = 0                     => nothing is being loaded now"
puts "   icap_i word 12 = 0x5599AA66         => fix#6 is on the board"
puts "   icap_i word 12 = 0xAA995566         => fix#5 build still flashed"
puts "   status 9->D after word 12           => ICAP finally synced"
puts "=============================================================="
